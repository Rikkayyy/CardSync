# Copy to .env and adjust if needed. Used by docker-compose.yml for local Postgres.
POSTGRES_DB=cardsync
POSTGRES_USER=cardsync
POSTGRES_PASSWORD=cardsync

# Backend picks these up too (see backend/src/main/resources/application.properties)
# 5433, not 5432 -- avoids clashing with a locally-installed Postgres instance
DB_HOST=localhost
DB_PORT=5433
JWT_SECRET=dev-only-secret-change-me-before-anything-real-CardSync
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000
