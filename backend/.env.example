# Copy to .env, then run `./run.sh` (not `./mvnw spring-boot:run` directly) —
# it sources this file before starting Maven so you don't have to.

POSTGRES_DB=cardsync
POSTGRES_USER=cardsync
POSTGRES_PASSWORD=cardsync

# 5433, not 5432 -- avoids clashing with a locally-installed Postgres instance
DB_HOST=localhost
DB_PORT=5433
# `disable` locally (docker-compose Postgres has no TLS); `require` on Neon
DB_SSLMODE=disable
JWT_SECRET=dev-only-secret-change-me-before-anything-real-CardSync
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Plaid (Sandbox) -- get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# AES-256 key for encrypting Plaid access tokens at rest -- generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
